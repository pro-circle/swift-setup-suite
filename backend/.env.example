# Supabase Postgres connection string
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the session pooler URI and replace [YOUR-PASSWORD] with your database password.
SUPABASE_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
